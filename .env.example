BACKEND_INTERNAL_URL=http://backend:3000
REDIS_URL=redis://redis:6379
PUBLIC_APP_ORIGIN=https://itsm.example.com
AUTH_COOKIE_SECURE=true
AUTH_CSRF_SECRET=replace-with-at-least-32-random-characters
# Déployer exactement cette même variable et cette même valeur dans le BFF et le backend Nest.
AUTH_ACCESS_COOKIE_NAME=__Host-access-token
AUTH_REFRESH_COOKIE_NAME=__Host-refresh-token
AUTH_CSRF_COOKIE_NAME=__Host-csrf-token

# SSO Keycloak (optionnel) : passer AUTH_PROVIDER=keycloak pour déléguer
# l'identité à Keycloak (Authorization Code + PKCE via /api/auth/keycloak/*).
AUTH_PROVIDER=local
KEYCLOAK_CLIENT_ID=telecom-frontend
KEYCLOAK_ISSUER=http://localhost:8080/realms/telecom
KEYCLOAK_REDIRECT_URI=http://localhost:3001/api/auth/keycloak/callback
