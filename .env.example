BACKEND_INTERNAL_URL=http://backend:3000
REDIS_URL=redis://redis:6379
PUBLIC_APP_ORIGIN=https://itsm.example.com
AUTH_COOKIE_SECURE=true
AUTH_CSRF_SECRET=replace-with-at-least-32-random-characters
# Déployer exactement cette même variable et cette même valeur dans le BFF et le backend Nest.
AUTH_ACCESS_COOKIE_NAME=__Host-access-token
AUTH_REFRESH_COOKIE_NAME=__Host-refresh-token
AUTH_CSRF_COOKIE_NAME=__Host-csrf-token

# SSO Keycloak unique : Authorization Code + PKCE via /api/auth/keycloak/*.
KEYCLOAK_CLIENT_ID=telecom-frontend
# Port 8081 : 8080 est utilisé par PhotoVault sur l'hôte.
KEYCLOAK_ISSUER=http://localhost:8081/realms/telecom
# En conteneur Docker, le compose le surcharge par le nom de service :
# KEYCLOAK_INTERNAL_ISSUER=http://keycloak:8080/realms/telecom (le conteneur ne
# joint pas l'hôte via localhost). En dev local, l'issuer public suffit.
KEYCLOAK_INTERNAL_ISSUER=http://localhost:8081/realms/telecom
KEYCLOAK_REDIRECT_URI=http://localhost:3007/api/auth/keycloak/callback
